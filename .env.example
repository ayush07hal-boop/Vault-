# Copy this file to ".env" and fill in your own values. ".env" is git-ignored; this template is committed.

# Google OAuth "Web application" client ID (Google Cloud Console > Credentials).
# Authorized JavaScript origin must include http://localhost:5173
VAULT_GOOGLE_CLIENT_ID=

# Google accounts allowed to become admin (comma-separated). Admins also need the password below.
VAULT_ADMIN_EMAILS=

# Shared admin password (second step after Google sign-in). If empty, a random one is printed in the API log.
VAULT_ADMIN_PASSWORD=

# true = anyone can sign in with any email, no Google check (local demos only).
VAULT_AUTH_DEVLOGIN=false

# Optional: long random value to keep sessions across restarts / several API instances.
VAULT_TOKEN_SECRET=

# Optional: extra browser origins allowed to call the API (comma-separated)
# VAULT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
