# Settings for the Docker deployment. setup.sh creates the real ".env" from your answers; this is the reference.

# Public hostname of the backend, e.g. vault-yourname.duckdns.org (must point at the VM's public IP)
DOMAIN=

# Google OAuth Web client ID and the accounts allowed into the admin area
VAULT_GOOGLE_CLIENT_ID=
VAULT_ADMIN_EMAILS=
VAULT_ADMIN_PASSWORD=

# Your website's address (Vercel), so the browser is allowed to call the API. Comma-separated.
VAULT_CORS_ORIGINS=

# Generated by setup.sh
POSTGRES_PASSWORD=
VAULT_TOKEN_SECRET=

# Optional tuning
# NODE_CAPACITY_BYTES=8589934592        # capacity reported by each of the 4 storage nodes (8 GiB)
# VAULT_USER_QUOTA_BYTES=4294967296     # per-account limit (4 GiB)
